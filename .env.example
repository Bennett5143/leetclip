# Path to the folder in your Obsidian vault where notes are written.
LEETCODE_NOTES_DIR=/path/to/your/obsidian/vault/LeetCode

# LeetCode session cookie. Optional on macOS + Safari (auto-read).
# See docs/authentication.md.
# LEETCODE_SESSION=

# AI review provider (default: anthropic).
# REVIEW_PROVIDER=anthropic
# REVIEW_MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...

# For an OpenAI-compatible provider (Ollama, LM Studio, OpenRouter, OpenAI):
# REVIEW_PROVIDER=openai-compatible
# REVIEW_BASE_URL=http://localhost:11434/v1
# REVIEW_MODEL=llama3
# REVIEW_API_KEY=

# Override the output templates (defaults: prompts/review.md, templates/note.md).
# REVIEW_PROMPT_FILE=
# NOTE_TEMPLATE_FILE=
